{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageAccountName": {
      "value": "yourstorageaccount"
    },
    "containerImage": {
      "value": "ghcr.io/YOUR_GITHUB_USERNAME/YOUR_REPO_NAME/video-worker:latest"
    },
    "firebaseAuthSecret": {
      "value": "your-firebase-auth-secret"
    },
    "firebaseBasePath": {
      "value": "https://your-firebase-project.firebaseio.com"
    },
    "location": {
      "value": "northeurope"
    }
  }
}
